-- OCR / 截屏票据原图与缩略图路径。event_id 关联 auto_event.id；确认入账时路径写入 Bill.images。
CREATE TABLE ticket_image (
  event_id TEXT NOT NULL,
  path TEXT NOT NULL,
  thumb_path TEXT NOT NULL DEFAULT '',
  create_time INTEGER NOT NULL DEFAULT 0,
  PRIMARY KEY (event_id, path)
);

selectByEvent:
SELECT * FROM ticket_image WHERE event_id = :eventId ORDER BY create_time ASC;

deleteByEvent:
DELETE FROM ticket_image WHERE event_id = :eventId;

deleteOne:
DELETE FROM ticket_image WHERE event_id = :eventId AND path = :path;

upsert:
INSERT OR REPLACE INTO ticket_image(event_id, path, thumb_path, create_time) VALUES ?;
